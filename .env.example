# Modèle sans valeurs — les vraies valeurs vivent uniquement dans les
# variables d'environnement Vercel (jamais dans le dépôt).

# Envoi d'e-mails (Resend, HTTPS)
RESEND_API_KEY=
CONTACT_SENDER_EMAIL=
CONTACT_RECIPIENT_EMAIL=

# Anti-spam Cloudflare Turnstile (optionnel ; activé si la clé secrète est définie)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Leads /pac → Google Sheet (Make / Zapier / Apps Script), optionnel.
# Le jeton est envoyé en en-tête Authorization: Bearer, X-Webhook-Token
# et dans le champ JSON "token" : à vérifier côté scénario avant d'écrire.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
